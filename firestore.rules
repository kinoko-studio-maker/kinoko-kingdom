// キノコ王国 ― ランキングの書きこみルール（Firebase の「Firestore → ルール」に貼りつける）
// ・だれでも読める
// ・自分の記録（自分の仮アカウントの番号の場所）だけ、作る・書きかえる・消すことができる
// ・名前は24文字まで、点数は0以上のふつうの数（無限大や NaN はだめ）、書きかえは60秒に1回まで
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{playerId} {
      allow read: if true;
      allow create: if isOwner(playerId) && isValidScore();
      allow update: if isOwner(playerId) && isValidScore()
                    && request.time > resource.data.updatedAt + duration.value(60, 's');
      allow delete: if isOwner(playerId);
    }

    function isOwner(playerId) {
      return request.auth != null && request.auth.uid == playerId;
    }

    // 0以上のふつうの数か。小数のときは、無限大と NaN をはじく
    // （ふつうの数は「自分 − 自分 = 0」になるが、無限大と NaN は 0 にならない）
    function isGoodScore(n) {
      return (n is int && n >= 0)
        || (n is float && n >= 0.0 && n - n == 0.0);
    }

    function isValidScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'stars', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
        && isGoodScore(d.score)
        && d.stars is int && d.stars >= 0 && d.stars < 1000000
        && d.updatedAt == request.time;
    }
  }
}
